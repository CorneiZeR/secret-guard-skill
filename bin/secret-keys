#!/usr/bin/env python3
"""Show what a secret file holds — its keys, each value's length and fingerprint — never a value.

  secret-keys FILE|DIR ...   dotenv, JSON, YAML, PEM, single tokens; a directory file by file
  secret-keys -              the same for stdin (e.g. a GitLab variables API response)
  secret-keys --env          the environment of this shell

fp= is an HMAC-SHA256 under a key kept on this machine only, so equal values
compare equal here while a fingerprint in a transcript cannot be brute-forced
back into a short password.
"""

import hashlib
import hmac
import json
import os
import re
import secrets
import sys

ENV_LINE = re.compile(r"^\s*(?:export\s+)?([A-Za-z_][A-Za-z0-9_.\-]*)\s*=\s*(.*)$")
SALT_FILE = os.environ.get(
    "SECRET_KEYS_SALT_FILE", os.path.expanduser("~/.config/secret-keys/salt")
)
_salt = None


def salt():
    global _salt
    if _salt is None:
        try:
            with open(SALT_FILE, "rb") as fh:
                _salt = fh.read()
        except FileNotFoundError:
            os.makedirs(os.path.dirname(SALT_FILE), mode=0o700, exist_ok=True)
            _salt = secrets.token_bytes(32)
            fd = os.open(SALT_FILE, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
            with os.fdopen(fd, "wb") as fh:
                fh.write(_salt)
    return _salt


def fingerprint(value):
    return hmac.new(salt(), value.encode(), hashlib.sha256).hexdigest()[:12]


def size(value):
    if value is None:
        return "null"
    value = str(value).strip()
    if len(value) >= 2 and value[0] == value[-1] and value[0] in "'\"":
        value = value[1:-1]
    return f"{len(value)} chars  fp={fingerprint(value)}" if value else "empty"


def gitlab_variables(data):
    return isinstance(data, list) and data and all(
        isinstance(x, dict) and "key" in x and "value" in x for x in data
    )


def walk(node, path, out):
    if isinstance(node, dict):
        if not node:
            out.append(f"{path or '.'}  {{}}")
        for k, v in node.items():
            walk(v, f"{path}.{k}" if path else str(k), out)
    elif isinstance(node, list):
        out.append(f"{path or '.'}  list of {len(node)}")
        for i, v in enumerate(node[:50]):
            walk(v, f"{path}[{i}]", out)
    elif isinstance(node, bool) or isinstance(node, (int, float)):
        out.append(f"{path}  {type(node).__name__}")
    else:
        out.append(f"{path}  {size(node)}")


def describe(text):
    stripped = text.strip()
    if not stripped:
        return ["empty"]
    if stripped[0] in "[{":
        try:
            data = json.loads(stripped)
        except ValueError:
            pass
        else:
            if gitlab_variables(data):
                return [
                    f"{v['key']}  {size(v.get('value'))}  scope={v.get('environment_scope', '*')}"
                    f"  protected={v.get('protected')}  masked={v.get('masked')}"
                    for v in data
                ]
            out = []
            walk(data, "", out)
            return out
    pem = re.findall(r"-----BEGIN ([A-Z0-9 ]+)-----", text)
    if pem:
        return [f"PEM block: {kind}" for kind in pem] + [f"whole file  {size(stripped)}"]
    lines = [ln for ln in text.splitlines() if ln.strip() and not ln.lstrip().startswith("#")]
    env = [ENV_LINE.match(ln) for ln in lines]
    if lines and sum(bool(m) for m in env) >= max(1, len(lines) // 2):
        return [
            f"{m.group(1)}  {size(m.group(2).split(' #')[0])}" if m else f"(line not KEY=value, {len(ln)} chars)"
            for m, ln in zip(env, lines)
        ]
    yaml_keys = [re.match(r"^(\s*)([A-Za-z0-9_.\-]+):(\s*)(.*)$", ln) for ln in lines]
    if lines and sum(bool(m) for m in yaml_keys) >= max(1, len(lines) // 2):
        return [
            f"{m.group(1)}{m.group(2)}  {size(m.group(4)) if m.group(4) else '(section)'}"
            for m in yaml_keys if m
        ]
    if len(lines) == 1:
        return [f"one value, {size(stripped)}"]
    return [f"{len(lines)} lines, {len(text)} bytes, no KEY=value structure, "
            f"whole file fp={fingerprint(text)}"]


def show(path):
    if os.path.isdir(path):
        for root, dirs, files in os.walk(path):
            dirs[:] = sorted(d for d in dirs if d != ".git")
            for f in sorted(files):
                show(os.path.join(root, f))
        return
    try:
        with open(path, "rb") as fh:
            raw = fh.read(1 << 20)
    except OSError as e:
        print(f"== {path}: {e.strerror}")
        return
    print(f"== {path}")
    try:
        text = raw.decode()
    except UnicodeDecodeError:
        fp = hmac.new(salt(), raw, hashlib.sha256).hexdigest()[:12]
        print(f"  binary, {len(raw)} bytes  fp={fp}")
        return
    for line in describe(text):
        print(f"  {line}")


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    if argv == ["--env"]:
        for k in sorted(os.environ):
            print(f"{k}  {size(os.environ[k])}")
        return 0
    for a in argv:
        if a == "-":
            print("== stdin")
            for line in describe(sys.stdin.read()):
                print(f"  {line}")
        else:
            show(os.path.expanduser(a))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
